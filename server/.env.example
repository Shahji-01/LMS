# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/lms

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Client URL (for CORS & email links)
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration (required)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (optional — queues and caching; app works without it)
REDIS_URL=redis://localhost:6379

# SMTP Configuration (optional — emails log to console if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Stripe Configuration (optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay Configuration (optional)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Sentry (optional — error tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project

# Rate Limiting & Proxy Configuration
# Set to 1 if behind a reverse proxy like Render, Vercel, or Nginx
# TRUST_PROXY=1

# Feature Flags
ENABLE_QUEUES=true